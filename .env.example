# ============================================================
# AniMemo MVP environment variables
# ============================================================
# このファイルを .env にコピーして、Supabase Dashboard の値に置き換えてください。
# service_role key はこのMVPでは使いません。絶対にここへ入れないでください。

# ------------------------------------------------------------
# Supabase Auth public settings
# ------------------------------------------------------------
# Supabase Dashboard > Project Settings > API で確認します。
# 「Project URL」を入れてください。
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"

# Supabase Dashboard > Project Settings > API で確認します。
# 「anon public」または「publishable」key を入れてください。
# service_role key は入れないでください。
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# ------------------------------------------------------------
# PostgreSQL connection string for Prisma
# ------------------------------------------------------------
# Supabase Dashboard > Project Settings > Database で確認します。
# Connection string の URI をコピーし、[YOUR-PASSWORD] をDatabase passwordに置き換えてください。
# パスワードに記号が含まれる場合はURLエンコードしてください。
DATABASE_URL="postgresql://postgres.your-project-ref:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"

# 任意:
# Prisma db:push 用に、Supabase ORM画面のDIRECT_URLも必ず入れてください。
DIRECT_URL="postgresql://postgres.your-project-ref:password@aws-0-region.pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------
# Auth callback base URL
# ------------------------------------------------------------
# ローカル開発ではこのままでOKです。
# 本番環境では公開URLに変更してください。
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ------------------------------------------------------------
# Admin access
# ------------------------------------------------------------
# 管理画面へ入れるメールアドレスをカンマ区切りで指定します。
# 例: ADMIN_EMAILS="admin@example.com,owner@example.com"
ADMIN_EMAILS=""
